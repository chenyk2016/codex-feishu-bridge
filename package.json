{
  "name": "codex-feishu-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "for file in src/*.mjs; do node --check \"$file\" || exit; done",
    "test": "node --test src/*.test.mjs && /usr/bin/python3 -m unittest discover -s src -p \"test_*.py\"",
    "test:mermaid": "RUN_MERMAID_BROWSER_TEST=1 node --test src/mermaid-renderer.test.mjs",
    "docs:dev": "vitepress docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "mermaid": "12.3.0",
    "playwright-core": "1.64.1"
  },
  "version": "0.2.0",
  "description": "A self-hosted macOS bridge between Codex desktop and a Feishu bot",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "keywords": [
    "codex",
    "feishu",
    "macos",
    "chatbot",
    "self-hosted",
    "developer-tools",
    "notifications"
  ],
  "overrides": {
    "vitepress": {
      "vite": "6.4.6"
    }
  }
}
